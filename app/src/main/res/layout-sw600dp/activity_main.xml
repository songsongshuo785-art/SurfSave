<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <variable name="viewModel" type="com.myAllVideoBrowser.ui.main.home.MainViewModel" />
    </data>
    <FrameLayout
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/sxSurface"
            android:clipChildren="false">
            <com.google.android.material.navigationrail.NavigationRailView
                android:id="@+id/bottom_bar"
                android:layout_width="@dimen/tablet_navigation_rail_width"
                android:layout_height="0dp"
                android:background="@drawable/sx_bottom_nav_background"
                android:paddingTop="@dimen/spacing_lg"
                android:paddingBottom="@dimen/spacing_lg"
                app:itemIconTint="@color/sx_navigation_item_color"
                app:itemTextColor="@color/sx_navigation_item_color"
                app:itemIconSize="24dp"
                app:labelVisibilityMode="labeled"
                app:menu="@menu/menu_bottom_bar"
                app:selectedItemId="@{viewModel.currentItem}"
                app:itemActiveIndicatorStyle="@style/Widget.Surf.NavigationIndicator"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/view_pager"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:currentItem="@{viewModel.currentItem}"
                app:offScreenPageLimit="@{viewModel.offScreenPageLimit}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/bottom_bar"
                app:layout_constraintTop_toTopOf="parent" />
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/bottom_bar"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/fragment_container_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>
