<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sxSurface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/history_toolbar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@drawable/sx_toolbar_background"
        android:contentInsetStart="8dp"
        android:contentInsetEnd="8dp"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:title="@string/download_history"
        app:titleTextAppearance="@style/TextAppearance.Surf.ScreenTitle"
        app:titleTextColor="@color/sxTextPrimary" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/history_search_container"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:hint="@string/download_history_search_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/history_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp" />

        <LinearLayout
            android:id="@+id/history_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download_history_empty"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_medium" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
