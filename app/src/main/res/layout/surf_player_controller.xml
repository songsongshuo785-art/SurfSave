<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/player_bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/surf_player_bottom_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:layoutDirection="ltr">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@id/exo_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@id/exo_rew"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/pip_rewind"
                app:srcCompat="@drawable/surf_player_rewind"
                app:tint="@android:color/white" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@id/exo_play_pause"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/surf_player_play_background"
                android:padding="16dp"
                android:contentDescription="@string/pip_play"
                app:tint="@android:color/black" />
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@id/exo_ffwd"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:contentDescription="@string/pip_forward"
                app:srcCompat="@drawable/surf_player_forward"
                app:tint="@android:color/white" />
            <TextView
                android:id="@id/exo_duration"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:maxLines="1"
                android:textColor="@android:color/white"
                android:textSize="13sp" />
        </LinearLayout>
        <androidx.media3.ui.DefaultTimeBar
            android:id="@id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:bar_height="3dp"
            app:played_color="@android:color/white"
            app:buffered_color="#80FFFFFF"
            app:unplayed_color="#40FFFFFF"
            app:scrubber_color="@android:color/white"
            app:scrubber_enabled_size="10dp"
            app:scrubber_dragged_size="16dp"
            app:touch_target_height="48dp" />
    </LinearLayout>
</merge>
