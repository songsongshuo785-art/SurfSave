<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable name="viewModel" type="com.myAllVideoBrowser.ui.main.video.VideoViewModel" />
        <variable name="mainViewModel" type="com.myAllVideoBrowser.ui.main.home.MainViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sxSurface">
        <LinearLayout
            android:id="@+id/video_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/sx_toolbar_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:contentInsetStart="0dp"
                android:contentInsetEnd="0dp"
                app:contentInsetStart="0dp"
                app:contentInsetEnd="0dp"
                app:title="@string/title_video"
                app:titleTextColor="@color/sxTextPrimary"
                app:titleTextAppearance="@style/TextAppearance.Surf.ScreenTitle" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/video_library_subtitle"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_small"
                android:id="@+id/library_subtitle"
                android:textAppearance="@style/TextAppearance.Surf.Body"
                android:layout_marginBottom="8dp" />
            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/surf_library_search"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp"
                app:endIconMode="clear_text"
                app:startIconDrawable="@drawable/search_24px">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/search_library"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:fillViewport="false">
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/library_filters"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:singleLine="true"
                    app:checkedChip="@id/library_all"
                    app:chipSpacingHorizontal="6dp">
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Surf.FilterChip"
                        android:id="@+id/library_all"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/surf_filter_all" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Surf.FilterChip"
                        android:id="@+id/library_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/surf_filter_video" />
                    <com.google.android.material.chip.Chip
                        style="@style/Widget.Surf.FilterChip"
                        android:id="@+id/library_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/surf_filter_audio" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/sort_library_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:minHeight="48dp"
                android:text="@string/video_sort_newest"
                android:textAllCaps="false" />
        </LinearLayout>
        <FrameLayout
            android:id="@+id/finished_native_ad_container"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_header" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_video"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:padding="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/finished_native_ad_container" />
        <androidx.core.widget.NestedScrollView
            android:id="@+id/layout_empty"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/video_header">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:gravity="center"
              android:orientation="vertical"
              android:padding="24dp">
            <FrameLayout android:layout_width="64dp" android:layout_height="64dp">
                <ImageView
                    android:id="@+id/iv_empty_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_video_24dp"
                    app:tint="@color/colorPrimary" />
            </FrameLayout>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_empty_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_large"
                android:text="@string/empty_video_title"
                android:textAppearance="@style/TextAppearance.Surf.TitleMedium"
                android:textColor="@color/sxTextPrimary" />
            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:gravity="center"
                android:text="@string/empty_video_subtitle"
                android:textAppearance="@style/TextAppearance.Surf.Body"
                android:textColor="@color/sxTextSecondary"
                android:id="@+id/tv_empty_subtitle" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/empty_action_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_large"
                android:text="@string/empty_action_browse"
                app:icon="@drawable/search_24px"
                app:iconTint="@color/colorOnPrimary" />
          </LinearLayout>
        </androidx.core.widget.NestedScrollView>
        <FrameLayout
            android:id="@+id/anchor"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
