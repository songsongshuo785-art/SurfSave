<?xml version="1.0" encoding="utf-8"?>
<!--
    Surf 通用空态组件。
    调用方传入 title、subtitle，可选 primary button。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="title"
            type="String" />
        <variable
            name="subtitle"
            type="String" />
        <variable
            name="buttonText"
            type="String" />
        <variable
            name="buttonListener"
            type="android.view.View.OnClickListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/spacing_3xl">

        <ImageView
            android:id="@+id/surf_empty_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.45"
            android:contentDescription="@null"
            android:src="@drawable/ic_empty"
            app:tint="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/surf_empty_title"
            style="@style/TextAppearance.Surf.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_lg"
            android:gravity="center"
            android:text="@{title}" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/surf_empty_subtitle"
            style="@style/TextAppearance.Surf.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:alpha="0.7"
            android:gravity="center"
            android:text="@{subtitle}"
            android:visibility="@{subtitle == null ? View.GONE : View.VISIBLE}" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/surf_empty_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xl"
            android:onClick="@{buttonListener}"
            android:text="@{buttonText}"
            android:visibility="@{buttonText == null ? View.GONE : View.VISIBLE}" />
    </LinearLayout>
</layout>
