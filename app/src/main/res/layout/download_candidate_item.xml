<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
        <variable name="listener" type="com.myAllVideoBrowser.ui.component.adapter.CandidateFormatListener" />
        <variable name="download_candidate" type="String" />
        <variable name="is_candidate_selected" type="Boolean" />
        <variable name="videoInfo" type="com.myAllVideoBrowser.data.local.room.entity.VideoInfo" />
    </data>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="0dp"
        android:checkable="true"
        android:checked="@{is_candidate_selected}"
        android:onClick="@{() -&gt; listener.onSelectFormat(videoInfo, download_candidate)}"
        android:onLongClick="@{() -&gt; listener.onFormatUrlShare(videoInfo, download_candidate)}"
        app:cardBackgroundColor="@{is_candidate_selected ? @color/sxSurfaceSelected : @color/sxSurfaceRaised}"
        app:cardCornerRadius="@dimen/corner_thumbnail"
        app:cardElevation="0dp"
        app:checkedIconTint="@color/colorPrimary"
        app:strokeColor="@{is_candidate_selected ? @color/colorPrimary : @color/sxOutline}"
        app:surfStrokeWidthPx="@{is_candidate_selected ? @dimen/stroke_selected : @dimen/stroke_hairline}"
        android:minHeight="64dp"
        android:layout_marginBottom="6dp"
        app:checkedIconSize="20dp"
        app:checkedIconMargin="12dp"
        android:contentDescription="@{tvTitle.text + `, ` + tvData.text}">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp"
            android:paddingStart="12dp"
            android:paddingEnd="44dp">
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/sxTextPrimary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1080p MP4" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_tiny"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_tiny"
                tools:text="MP4 video&#10;Size 42 MB&#10;Duration 01:25" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
