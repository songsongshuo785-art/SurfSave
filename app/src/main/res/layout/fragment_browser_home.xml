<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".ui.main.home.browser.homeTab.BrowserHomeFragment">
    <data>
        <import type="android.view.View" />
        <variable name="browserMenuListener" type="com.myAllVideoBrowser.ui.main.home.browser.BrowserListener" />
        <variable name="viewModel" type="com.myAllVideoBrowser.ui.main.home.browser.homeTab.BrowserHomeViewModel" />
        <variable name="mainVModel" type="com.myAllVideoBrowser.ui.main.home.MainViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/sxSurface">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/materialToolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@drawable/sx_toolbar_background"
            android:paddingStart="@dimen/padding_small"
            android:paddingEnd="@dimen/padding_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/app_name"
            app:logo="@drawable/surf_brand_wave"
            app:titleTextColor="@color/sxTextPrimary"
            app:titleTextAppearance="@style/TextAppearance.Surf.TitleLarge">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <FrameLayout
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="end|center_vertical">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/browser_home_tabs_button"
                        android:layout_width="@dimen/min_touch_target"
                        android:layout_height="@dimen/min_touch_target"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/tabs"
                        android:onClick="@{() -&gt; browserMenuListener.onTabsOverviewClicked()}"
                        android:padding="10dp"
                        app:srcCompat="@drawable/tab_group_24px"
                        app:tint="@color/sxTextPrimary"
                        tools:ignore="VectorDrawableCompat" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/browser_home_tabs_count_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="1dp"
                        android:layout_marginEnd="1dp"
                        android:background="@drawable/sx_primary_badge_background"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:paddingStart="5dp"
                        android:paddingEnd="5dp"
                        android:textColor="@color/colorBadgeText"
                        android:textSize="@dimen/text_tiny"
                        android:textStyle="bold"
                        android:translationZ="2dp"
                        tools:text="12" />
                </FrameLayout>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/browser_home_menu_button"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/menu"
                    android:onClick="@{() -&gt; browserMenuListener.onBrowserMenuClicked()}"
                    android:padding="10dp"
                    app:srcCompat="@drawable/ic_more_24dp"
                    app:tint="@color/sxTextPrimary"
                    tools:ignore="VectorDrawableCompat" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
        <androidx.core.widget.NestedScrollView
            android:id="@+id/home_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:scrollbars="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/materialToolbar">
            <LinearLayout
                android:id="@+id/home_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="0dp"
                android:paddingBottom="32dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/sx_search_background"
                    android:padding="4dp">
                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/home_et_search"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:drawableStart="@drawable/search_24px"
                        android:drawablePadding="@dimen/padding_normal"
                        android:drawableTint="@color/sxTextSecondary"
                        android:focusable="@{viewModel.isSearchInputFocused}"
                        android:focusableInTouchMode="@{viewModel.isSearchInputFocused}"
                        android:hint="@string/browser_search_hint"
                        android:imeOptions="actionSearch"
                        android:inputType="textUri"
                        android:onClick="@{() -&gt; viewModel.changeSearchFocus(true)}"
                        android:paddingStart="12dp"
                        android:paddingEnd="4dp"
                        android:singleLine="true"
                        android:text="@{viewModel.searchTextInput}"
                        android:textColor="@color/sxTextPrimary"
                        android:textColorHint="@color/sxTextSecondary"
                        android:textSize="16sp"
                        app:items="@{viewModel.listSuggestions}" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_search_button"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="0dp"
                        android:contentDescription="@string/home_search_action"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text=""
                        app:cornerRadius="14dp"
                        app:icon="@drawable/arrow_forward_24px"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconTint="@color/colorOnPrimary" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_paste_link_button"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="@dimen/padding_small"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/home_paste_and_open"
                        android:textAllCaps="false"
                        app:cornerRadius="@dimen/corner_md"
                        app:icon="@drawable/add_new_tab_icon24"
                        style="@style/Widget.Surf.Button.TextButton"
                        android:paddingHorizontal="8dp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_how_it_works_button"
                        style="@style/Widget.Surf.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:text="@string/home_how_it_works"
                        android:textAllCaps="false"
                        android:textColor="@color/sxTextPrimary"
                        app:cornerRadius="@dimen/corner_md"
                        app:icon="@drawable/help_24px"
                        app:iconTint="@color/sxTextPrimary"
                        app:strokeColor="@color/sxOutline"
                        android:paddingHorizontal="8dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/surf_home_favorites"
                        android:textAppearance="@style/TextAppearance.Surf.TitleMedium"
                        android:textColor="@color/colorOnSurface" />
                    <com.google.android.material.button.MaterialButton
                        style="@style/Widget.Surf.Button.TextButton"
                        android:id="@+id/home_add_bookmark_card"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="@string/add_bookmark"
                        android:minWidth="0dp"
                        app:icon="@drawable/add_new_tab_icon24"
                        app:iconPadding="4dp" />
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/home_common_sites_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:itemCount="4"
                    tools:listitem="@layout/item_top_page" />
                <LinearLayout
                    android:id="@+id/home_tabs_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:layout_marginTop="24dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/tab_group_24px"
                        android:contentDescription="@null"
                        app:tint="@color/colorOnSurfaceVariant" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/home_tabs_count_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="12dp"
                        android:textAppearance="@style/TextAppearance.Surf.Body"
                        android:textColor="@color/colorOnSurfaceVariant" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/arrow_forward_24px"
                        android:contentDescription="@null"
                        app:tint="@color/colorOnSurfaceVariant" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
