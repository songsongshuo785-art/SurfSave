<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <import type="android.view.View" />
        <variable name="dialogListener" type="com.myAllVideoBrowser.ui.component.adapter.DownloadTabListener" />
        <variable name="viewModel" type="com.myAllVideoBrowser.ui.main.home.browser.detectedVideos.VideoDetectionTabViewModel" />
    </data>
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/detected_videos_tab_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        tools:context=".ui.main.home.browser.detectedVideos.DetectedVideosTabFragment">
        <View
            android:id="@+id/detected_backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/colorScrim"
            android:onClick="@{() -&gt; dialogListener.onCancel()}"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <LinearLayout
            android:id="@+id/detected_sheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/surf_sheet_background"
            android:orientation="vertical"
            android:paddingStart="@dimen/padding_normal"
            android:paddingTop="0dp"
            android:paddingEnd="@dimen/padding_normal"
            android:paddingBottom="@dimen/padding_normal"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="16dp"
            app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
            app:behavior_hideable="true"
            app:behavior_skipCollapsed="true"
            app:behavior_peekHeight="0dp">
            <com.google.android.material.bottomsheet.BottomSheetDragHandleView
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal" />
            <LinearLayout
                android:id="@+id/detected_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{viewModel.detectedPanelTitle}"
                        android:textAppearance="@style/TextAppearance.Surf.TitleLarge"
                        android:textColor="@color/sxTextPrimary" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/detected_subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Surf.BodySmall"
                        android:textColor="@color/sxTextSecondary"
                        android:visibility="gone"
                        tools:text="来自 example.com"
                        tools:visibility="visible" />
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/detected_count"
                    android:layout_width="wrap_content"
                    android:layout_height="24dp"
                    android:layout_marginStart="@dimen/padding_small"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:background="@drawable/sx_primary_badge_background"
                    android:gravity="center"
                    android:minWidth="24dp"
                    android:paddingStart="@dimen/padding_small"
                    android:paddingEnd="@dimen/padding_small"
                    android:text="@{viewModel.detectedVideosBadgeText}"
                    android:textColor="@color/colorBadgeText"
                    android:textSize="@dimen/text_tiny"
                    android:textStyle="bold"
                    android:visibility="@{viewModel.hasDetectedVideos ? View.VISIBLE : View.GONE}" />
                <ImageButton
                    android:id="@+id/tv_cancel"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/dialog_download_cancel"
                    android:onClick="@{() -&gt; dialogListener.onCancel()}"
                    android:padding="12dp"
                    android:src="@drawable/ic_cancel_24dp"
                    app:tint="@color/sxTextPrimary" />
            </LinearLayout>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/detection_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:background="@drawable/sx_section_background"
                android:lineSpacingExtra="2dp"
                android:maxLines="2"
                android:padding="@dimen/padding_small"
                android:text="@{viewModel.detectionStatusText}"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_small"
                android:visibility="@{viewModel.hasDetectionStatus &amp;&amp; !viewModel.hasDetectedMedia &amp;&amp; !viewModel.hasProtectedMedia &amp;&amp; !viewModel.hasTelegramPostPreview ? View.VISIBLE : View.GONE}"
                tools:text="检测暂时失败。请播放视频后再试，或刷新页面重新检测。"
                tools:visibility="visible" />
            <LinearLayout
                android:id="@+id/drm_web_playback_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:background="@drawable/sx_section_background"
                android:orientation="vertical"
                android:padding="@dimen/padding_normal"
                android:visibility="@{viewModel.hasProtectedMedia &amp;&amp; !viewModel.hasDetectedVideos ? View.VISIBLE : View.GONE}"
                tools:visibility="visible">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:importantForAccessibility="no"
                        android:src="@drawable/shield_24px"
                        app:tint="@color/colorPrimary" />
                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/padding_small"
                        android:layout_weight="1"
                        android:text="@string/drm_detected_title"
                        android:textColor="@color/sxTextPrimary"
                        android:textSize="@dimen/text_medium"
                        android:textStyle="bold" />
                </LinearLayout>
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/drm_detected_message"
                    android:textColor="@color/sxTextSecondary"
                    android:textSize="@dimen/text_small" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_play_in_webpage"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/padding_small"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/drm_play_in_webpage"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    app:icon="@drawable/play_circle_24px"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/telegram_post_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_small"
                android:background="@drawable/sx_section_background"
                android:orientation="vertical"
                android:padding="@dimen/padding_normal"
                android:visibility="@{viewModel.hasTelegramPostPreview ? View.VISIBLE : View.GONE}"
                tools:visibility="visible">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@{viewModel.telegramPostChannel}"
                    android:textColor="@color/sxTextPrimary"
                    android:textSize="@dimen/text_medium"
                    android:textStyle="bold"
                    tools:text="@cctv1" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_tiny"
                    android:text="@{viewModel.telegramPostMediaSummary}"
                    android:textColor="@color/colorPrimary"
                    android:textSize="@dimen/text_small"
                    tools:text="2 个媒体 · 1 个可播放" />
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="156dp"
                    android:layout_marginTop="@dimen/padding_small"
                    android:background="@drawable/sx_thumbnail_background"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop"
                    android:visibility="@{viewModel.hasTelegramThumbnail &amp;&amp; !viewModel.hasDetectedVideos ? View.VISIBLE : View.GONE}"
                    app:imageUrl="@{viewModel.telegramPostThumbnail}" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="@{viewModel.telegramPostDescription}"
                    android:textColor="@color/sxTextSecondary"
                    android:textSize="@dimen/text_small"
                    android:visibility="@{viewModel.hasTelegramDescription ? View.VISIBLE : View.GONE}"
                    tools:text="Telegram 公开帖子的正文预览。" />
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/padding_small"
                    android:text="@string/telegram_post_poster_only_message"
                    android:textColor="@color/sxTextSecondary"
                    android:textSize="@dimen/text_small"
                    android:visibility="@{viewModel.hasTelegramPosterOnlyMedia ? View.VISIBLE : View.GONE}" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_open_telegram_post"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/min_touch_target"
                    android:layout_gravity="end"
                    android:layout_marginTop="@dimen/padding_small"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/telegram_open_in_app"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    android:visibility="@{viewModel.hasTelegramPosterOnlyMedia ? View.VISIBLE : View.GONE}"
                    app:icon="@drawable/open_in_new_24px"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/detected_secondary_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_tiny"
                android:gravity="end"
                android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_parse_playlist"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/playlist_parse_button"
                    android:textAllCaps="false"
                    android:textColor="@color/colorPrimary"
                    app:icon="@drawable/search_24px"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_scan_images"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:text="@string/detected_images_scan"
                android:textAllCaps="false"
                android:textColor="@color/colorPrimary"
                app:icon="@drawable/search_24px"
                app:iconTint="@color/colorPrimary" />
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/media_type_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="@{viewModel.hasDetectedMedia ? View.VISIBLE : View.GONE}"
                app:selectionRequired="true"
                app:singleSelection="true">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_video_tab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/detected_videos_tab_label"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_image_tab"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/detected_images_tab_label"
                    android:textAllCaps="false" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
            <LinearLayout
                android:id="@+id/media_type_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="@{viewModel.hasDetectedMedia ? View.VISIBLE : View.GONE}">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/video_tab_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@{viewModel.detectedVideosBadgeText}"
                    android:textColor="@color/sxTextSecondary"
                    android:textSize="@dimen/text_tiny" />
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/image_tab_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="@{viewModel.detectedImagesBadgeText}"
                    android:textColor="@color/sxTextSecondary"
                    android:textSize="@dimen/text_tiny" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/video_info_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:paddingBottom="@dimen/padding_small"
                app:items="@{viewModel.sortedDetectedVideosList}" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/image_info_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/padding_small"
                android:visibility="gone"
                app:items="@{viewModel.sortedDetectedImagesList}" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/image_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="@dimen/padding_normal"
                android:text="@string/detected_images_empty"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />
            <LinearLayout
                android:id="@+id/image_selection_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/image_selection_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/sxTextPrimary"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_select_all_images"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="@string/detected_images_select_all"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_clear_image_selection"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="@string/detected_images_clear_selection"
                    android:textAllCaps="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_download_selected_images"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:minWidth="0dp"
                    android:text="@string/detected_images_download_selected"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_download_24dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</layout>
