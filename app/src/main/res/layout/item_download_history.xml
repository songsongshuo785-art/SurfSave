<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/sxSurfaceRaised"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/sxOutline"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_history_thumbnail"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/sx_chip_background"
            android:contentDescription="@null"
            android:padding="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/play_circle_24px"
            app:tint="@color/colorPrimary" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_history_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/sxTextPrimary"
            android:textSize="@dimen/text_medium"
            app:layout_constraintEnd_toStartOf="@id/iv_history_more"
            app:layout_constraintStart_toEndOf="@id/iv_history_thumbnail"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_history_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/sxTextSecondary"
            android:textSize="@dimen/text_small"
            app:layout_constraintEnd_toStartOf="@id/iv_history_more"
            app:layout_constraintStart_toEndOf="@id/iv_history_thumbnail"
            app:layout_constraintTop_toBottomOf="@id/tv_history_title" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_history_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="8dp"
            android:textColor="@color/colorError"
            android:textSize="@dimen/text_small"
            app:layout_constraintEnd_toStartOf="@id/iv_history_more"
            app:layout_constraintStart_toEndOf="@id/iv_history_thumbnail"
            app:layout_constraintTop_toBottomOf="@id/tv_history_subtitle" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_history_more"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:padding="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_more_24dp"
            app:tint="@color/sxTextSecondary" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
