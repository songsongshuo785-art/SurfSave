<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="imageInfo"
            type="com.myAllVideoBrowser.data.local.room.entity.VideoInfo" />
        <variable
            name="viewModel"
            type="com.myAllVideoBrowser.ui.main.home.browser.detectedVideos.VideoDetectionTabViewModel" />
    </data>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        app:cardBackgroundColor="@color/sxSurfaceRaised"
        app:cardCornerRadius="@dimen/corner_thumbnail"
        app:cardElevation="0dp"
        app:strokeColor="@color/sxOutline"
        app:strokeWidth="@dimen/stroke_hairline">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/sx_thumbnail_background">
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/image_thumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/detected_image_download"
                    android:scaleType="centerCrop"
                    app:imageUrl="@{imageInfo.thumbnail}"
                    app:imageHeaders="@{imageInfo.thumbnailHeaders}" />
                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/image_checkbox"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:buttonTint="@color/colorPrimary"
                    android:contentDescription="@string/detected_image_select" />
            </FrameLayout>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/image_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@{imageInfo.title}"
                android:textColor="@color/sxTextPrimary"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                tools:text="cover.jpg" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/image_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@{imageInfo.ext}"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_tiny"
                tools:text="JPG" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/image_download_button"
                style="@style/Widget.Surf.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:minWidth="0dp"
                android:text="@string/detected_image_download"
                android:textAllCaps="false"
                app:icon="@drawable/ic_download_24dp"
                app:iconTint="@color/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>
