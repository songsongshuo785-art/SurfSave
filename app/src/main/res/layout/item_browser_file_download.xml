<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_file_download"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/padding_small"
    android:layout_marginVertical="@dimen/padding_tiny"
    android:minHeight="112dp"
    app:cardBackgroundColor="@color/sxSurfaceRaised"
    app:cardCornerRadius="8dp"
    app:cardElevation="@dimen/elev_resting"
    app:strokeColor="@color/sxOutline"
    app:strokeWidth="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="112dp"
        android:padding="@dimen/padding_normal">
        <FrameLayout
            android:id="@+id/file_icon_container"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/sx_thumbnail_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="9dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_download_24dp"
                app:tint="@color/colorPrimary" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tv_extension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:paddingBottom="7dp"
                android:textColor="@color/sxTextSecondary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="APK" />
        </FrameLayout>
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_marginEnd="@dimen/padding_tiny"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/sxTextPrimary"
            android:textSize="@dimen/text_medium"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/ip_more"
            app:layout_constraintStart_toEndOf="@id/file_icon_container"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="SurfSave-release-arm64-v8a.apk" />
        <ImageButton
            android:id="@+id/ip_more"
            android:layout_width="@dimen/min_touch_target"
            android:layout_height="@dimen/min_touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/browser_file_more_actions"
            android:padding="@dimen/padding_small"
            android:src="@drawable/ic_more_24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/sxTextSecondary" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_marginTop="@dimen/padding_tiny"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/sxTextSecondary"
            android:textSize="@dimen/text_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/file_icon_container"
            app:layout_constraintTop_toBottomOf="@id/tv_title"
            tools:text="Downloading 42%" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_marginTop="@dimen/padding_small"
            app:indicatorColor="@color/colorPrimary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/file_icon_container"
            app:layout_constraintTop_toBottomOf="@id/tv_status"
            app:trackColor="@color/sxOutline" />
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tv_metadata"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_normal"
            android:layout_marginTop="@dimen/padding_small"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/sxTextSecondary"
            android:textSize="@dimen/text_small"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/file_icon_container"
            app:layout_constraintTop_toBottomOf="@id/progress_bar"
            tools:text="12.4 MB · 2 minutes ago" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
