<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable name="videoInfo" type="com.myAllVideoBrowser.data.local.room.entity.VideoInfo" />
        <variable name="dialogListener" type="com.myAllVideoBrowser.ui.component.adapter.DownloadTabListener" />
        <variable name="viewModel" type="com.myAllVideoBrowser.ui.main.home.browser.detectedVideos.VideoDetectionTabViewModel" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
            <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginEnd="0dp"
                    android:clickable="true"
                    android:contentDescription="@string/dialog_preview_video"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:onClick="@{() -&gt; dialogListener.onPreviewVideo(videoInfo, videoThumbnail, viewModel.selectedFormats.get(videoInfo.id), false)}"
                    app:cardBackgroundColor="@color/sxSurfaceSoft"
                    app:cardCornerRadius="@dimen/corner_thumbnail"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sxOutline"
                    app:strokeWidth="0dp"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">
                    <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/video_thumbnail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/sx_thumbnail_background"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop"
                            app:imageUrl="@{videoInfo.thumbnail}" />
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:background="@drawable/sx_thumbnail_play_overlay"
                            android:contentDescription="@null"
                            android:importantForAccessibility="no"
                            android:padding="6dp"
                            android:src="@drawable/play_circle_24px"
                            android:alpha="0.9"
                            app:tint="@color/white" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/video_title_edit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="@string/video_title_edit"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLines="2"
                    android:minHeight="48dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:singleLine="false"
                    android:textColor="@color/sxTextPrimary"
                    android:textColorHint="@color/sxTextSecondary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/video_title_rename_button"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/padding_tiny"
                    android:contentDescription="@string/video_menu_rename"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:padding="0dp"
                    android:text=""
                    app:icon="@drawable/edit_24px"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/colorPrimary" />
            </LinearLayout>
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/typeTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:background="@android:color/transparent"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingTop="3dp"
                android:paddingEnd="0dp"
                android:paddingBottom="3dp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/text_tiny"
                android:textStyle="bold"
                tools:text="视频文件" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/sizeTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFeatureSettings="tnum"
                android:maxLines="2"
                android:textColor="@color/sxTextSecondary"
                android:textSize="@dimen/text_small"
                tools:text="Download Size: 26.4 MB" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/trustTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:lineSpacingExtra="2dp"
                android:padding="0dp"
                android:textColor="@color/sxTextSecondary"
                android:textSize="12sp"
                android:maxLines="2"
                tools:text="Source: example.com&#10;Cover verified" />
            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/urlTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@{viewModel.selectedFormatUrl}"
                android:textSize="@dimen/text_tiny"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/min_touch_target"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <com.google.android.material.textview.MaterialTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/surf_quality"
                    android:textColor="@color/sxTextPrimary"
                    android:textSize="@dimen/text_small"
                    android:textStyle="bold" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_share"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="@dimen/min_touch_target"
                    android:layout_height="@dimen/min_touch_target"
                    android:contentDescription="@string/share_link"
                    android:insetLeft="0dp"
                    android:insetTop="0dp"
                    android:insetRight="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:onClick="@{() -&gt; dialogListener.onFormatUrlShare(videoInfo, viewModel.selectedFormats.get(videoInfo.id))}"
                    android:padding="0dp"
                    android:text=""
                    app:icon="@drawable/share_24px"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconTint="@color/sxTextSecondary" />
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/candidatesList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingTop="@dimen/padding_small"
                android:paddingBottom="@dimen/padding_small"
                android:nestedScrollingEnabled="false" />
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Surf.Button.TextButton"
                android:id="@+id/quality_toggle"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/surf_quality_more"
                android:visibility="gone" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/padding_small"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/sxSurfaceRaised"
                    app:cardCornerRadius="@dimen/corner_full"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/sxOutline"
                    app:strokeWidth="@dimen/stroke_hairline">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tv_preview"
                            style="@style/Widget.Surf.Button.TextButton"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:backgroundTint="@android:color/transparent"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:onClick="@{() -&gt; dialogListener.onPreviewVideo(videoInfo, videoThumbnail, viewModel.selectedFormats.get(videoInfo.id), false)}"
                            android:text="@string/surf_play"
                            android:paddingHorizontal="8dp"
                            android:textColor="@color/sxTextPrimary"
                            android:textSize="@dimen/text_small"
                            app:icon="@drawable/play_circle_24px"
                            app:iconTint="@color/sxTextPrimary" />
                        <View
                            android:layout_width="@dimen/stroke_hairline"
                            android:layout_height="24dp"
                            android:background="@color/sxOutline" />
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/tv_player_options"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="@dimen/min_touch_target"
                            android:layout_height="match_parent"
                            android:backgroundTint="@android:color/transparent"
                            android:contentDescription="@string/player_target_choose"
                            android:insetLeft="0dp"
                            android:insetTop="0dp"
                            android:insetRight="0dp"
                            android:insetBottom="0dp"
                            android:minWidth="0dp"
                            android:onClick="@{() -&gt; dialogListener.onChoosePlayer(videoInfo, videoThumbnail, tvPlayerOptions, viewModel.selectedFormats.get(videoInfo.id), false)}"
                            android:padding="0dp"
                            android:text=""
                            app:icon="@drawable/ic_arrow_drop_down_24"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconTint="@color/sxTextPrimary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tv_download"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:onClick="@{() -&gt; dialogListener.onDownloadVideo(videoInfo, viewModel.selectedFormats.get(videoInfo.id), viewModel.formatsTitles.get(videoInfo.id))}"
                    android:text="@string/detected_download"
                    android:textColor="@color/colorOnPrimary"
                    android:textSize="@dimen/text_small"
                    android:minWidth="0dp"
                    android:paddingHorizontal="8dp"
                    app:iconPadding="4dp"
                    app:icon="@drawable/ic_download_24dp"
                    app:iconTint="@color/colorOnPrimary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</layout>
