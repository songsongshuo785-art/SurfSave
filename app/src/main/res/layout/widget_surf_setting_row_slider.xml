<?xml version="1.0" encoding="utf-8"?>
<!--
    Surf 设置行：滑块型。
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="title"
            type="String" />
        <variable
            name="valueText"
            type="String" />
        <variable
            name="valueFrom"
            type="Float" />
        <variable
            name="valueTo"
            type="Float" />
        <variable
            name="value"
            type="Float" />
        <variable
            name="listener"
            type="com.google.android.material.slider.Slider.OnChangeListener" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="@dimen/spacing_sm"
        android:paddingBottom="@dimen/spacing_sm">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/surf_setting_slider_title"
            style="@style/TextAppearance.Surf.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@{title}" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/surf_setting_slider_value"
            style="@style/TextAppearance.Surf.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@{valueText}" />

        <com.google.android.material.slider.Slider
            android:id="@+id/surf_setting_slider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:value="@{value}"
            android:valueFrom="@{valueFrom}"
            android:valueTo="@{valueTo}"
            app:surfOnChangeListener="@{listener}" />
    </LinearLayout>
</layout>
