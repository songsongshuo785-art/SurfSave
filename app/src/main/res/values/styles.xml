<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorSurfaceContainerLow</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="windowSplashScreenAnimationDuration">200</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
    <style name="Base.AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/colorSurfaceContainerLow</item>
        <item name="android:navigationBarColor">@color/colorSurfaceContainerLow</item>
        <item name="android:windowBackground">@color/colorSurface</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@transition/surf_shared_element</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorPrimaryContainer">@color/colorPrimaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/colorOnPrimaryContainer</item>
        <item name="colorSecondary">@color/colorSecondary</item>
        <item name="colorOnSecondary">@color/colorOnSecondary</item>
        <item name="colorSecondaryContainer">@color/colorSecondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/colorOnSecondaryContainer</item>
        <item name="colorTertiary">@color/colorTertiary</item>
        <item name="colorOnTertiary">@color/colorOnTertiary</item>
        <item name="colorTertiaryContainer">@color/colorTertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/colorOnTertiaryContainer</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorSurfaceVariant">@color/colorSurfaceContainerHigh</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorSurfaceInverse">@color/colorSurfaceContainerLowest</item>
        <item name="colorOnSurfaceInverse">@color/colorOnSurface</item>
        <item name="colorSurfaceContainerLowest">@color/colorSurfaceContainerLowest</item>
        <item name="colorSurfaceContainerLow">@color/colorSurfaceContainerLow</item>
        <item name="colorSurfaceContainer">@color/colorSurfaceContainer</item>
        <item name="colorSurfaceContainerHigh">@color/colorSurfaceContainerHigh</item>
        <item name="colorSurfaceContainerHighest">@color/colorSurfaceContainerHighest</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="colorOutlineVariant">@color/colorOutlineVariant</item>
        <item name="colorError">@color/colorError</item>
        <item name="colorOnError">@color/colorOnError</item>
        <item name="colorErrorContainer">@color/colorErrorContainer</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Surf.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Surf.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Surf.LargeComponent</item>
        <item name="materialButtonStyle">@style/Widget.Surf.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Surf.Button.OutlinedButton</item>
        <item name="materialButtonToggleGroupStyle">@style/Widget.Surf.ButtonToggleGroup</item>
        <item name="materialCardViewStyle">@style/Widget.Surf.CardView</item>
        <item name="switchStyle">@style/Widget.Surf.Switch</item>
        <item name="checkboxStyle">@style/Widget.Surf.CheckBox</item>
        <item name="radioButtonStyle">@style/Widget.Surf.RadioButton</item>
        <item name="sliderStyle">@style/Widget.Surf.Slider</item>
        <item name="textInputStyle">@style/Widget.Surf.TextInputLayout</item>
        <item name="bottomSheetStyle">@style/Widget.Surf.BottomSheet</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Surf.BottomSheetDialog</item>
        <item name="android:colorEdgeEffect">@color/colorOutline</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="fontFamily">sans-serif</item>
        <item name="toolbarStyle">@style/Widget.Surf.Toolbar</item>
    </style>
    <style name="AppTheme" parent="Base.AppTheme">
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="ShapeAppearance.Surf.SmallComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_sm</item>
    </style>
    <style name="ShapeAppearance.Surf.MediumComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_md</item>
    </style>
    <style name="ShapeAppearance.Surf.LargeComponent" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_lg</item>
    </style>
    <style name="TextAppearance.Surf.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">32sp</item>
        <item name="lineHeight">40sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Surf.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">24sp</item>
        <item name="lineHeight">32sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Surf.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="lineHeight">28sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="TextAppearance.Surf.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Surf.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Surf.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="lineHeight">24sp</item>
    </style>
    <style name="TextAppearance.Surf.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
    </style>
    <style name="TextAppearance.Surf.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
    </style>
    <style name="TextAppearance.Surf.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textSize">14sp</item>
        <item name="lineHeight">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Surf.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Surf.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="lineHeight">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TextAppearance.Surf.Title" parent="TextAppearance.Surf.TitleLarge" />
    <style name="TextAppearance.Surf.Caption" parent="TextAppearance.Surf.BodySmall" />
    <style name="TextAppearance.Surf.Number" parent="TextAppearance.Surf.Body">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="TextAppearance.Surf.NumberLarge" parent="TextAppearance.Surf.BodyLarge">
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="ShapeAppearance.Surf.Thumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/corner_thumbnail</item>
    </style>
    <style name="Widget.Surf.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_md</item>
        <item name="cardElevation">@dimen/elev_resting</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="strokeColor">@android:color/transparent</item>
        <item name="strokeWidth">0dp</item>
    </style>
    <style name="Widget.Surf.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/component_button_height</item>
        <item name="android:minWidth">64dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Surf.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Surf.Button.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/component_button_height</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Surf.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Surf.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/component_button_height</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Surf.LabelLarge</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>
    <style name="Widget.Surf.Button.IconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/component_icon_button_size</item>
        <item name="android:minHeight">@dimen/component_icon_button_size</item>
        <item name="iconSize">24dp</item>
    </style>
    <style name="Widget.Surf.ButtonToggleGroup" parent="Widget.Material3.MaterialButtonToggleGroup">
        <item name="android:padding">0dp</item>
        <item name="singleSelection">true</item>
    </style>
    <style name="Widget.Surf.Switch" parent="Widget.Material3.CompoundButton.Switch">
        <item name="android:minHeight">@dimen/component_list_item_one_line</item>
    </style>
    <style name="Widget.Surf.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:minHeight">@dimen/component_list_item_one_line</item>
    </style>
    <style name="Widget.Surf.RadioButton" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:minHeight">@dimen/component_list_item_one_line</item>
    </style>
    <style name="Widget.Surf.Slider" parent="Widget.Material3.Slider">
        <item name="trackHeight">@dimen/component_progress_indicator_height</item>
        <item name="haloRadius">12dp</item>
        <item name="thumbRadius">12dp</item>
    </style>
    <style name="Widget.Surf.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_sm</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_sm</item>
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerLow</item>
    </style>
    <style name="Widget.Surf.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.Surf.LargeComponent</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerLow</item>
        <item name="elevation">@dimen/elev_overlay</item>
    </style>
    <style name="ThemeOverlay.Surf.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Surf.BottomSheet</item>
    </style>
    <style name="customImageViewRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="TextAppearance.Surf.ScreenTitle" parent="TextAppearance.Surf.Headline">
        <item name="android:textSize">28sp</item>
        <item name="lineHeight">36sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="Widget.Surf.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Surf.ScreenTitle</item>
        <item name="titleTextColor">@color/colorOnSurface</item>
        <item name="navigationIconTint">@color/colorOnSurface</item>
        <item name="android:background">@color/colorSurface</item>
    </style>
    <style name="Widget.Surf.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="ensureMinTouchTargetSize">true</item>
        <item name="chipMinTouchTargetSize">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Surf.LabelMedium</item>
    </style>
    <style name="TextAppearance.Surf.Navigation" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Widget.Surf.NavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorPrimaryContainer</item>
        <item name="android:width">64dp</item>
        <item name="android:height">28dp</item>
    </style>
    <style name="TextAppearance.Surf.TabsTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="ShapeAppearance.Surf.TabPreview" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">12dp</item>
        <item name="cornerSizeTopRight">12dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
